APP_NAME=VeriSight Document Intelligence
ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
DATABASE_URL=postgresql+psycopg://verisight:verisight@db:5432/verisight
ACCESS_TOKEN_EXPIRE_MINUTES=480
UPLOAD_DIR=uploads
REPORT_DIR=reports
MAX_UPLOAD_MB=15
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
OCR_LANGUAGES=en
ENABLE_TRANSFORMERS=false
HF_DOCUMENT_MODEL=facebook/bart-large-mnli
HF_EXPLANATION_MODEL=google/flan-t5-small
